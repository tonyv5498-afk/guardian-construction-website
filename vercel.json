{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cities/traverse-city-mi-contractor.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cities/petoskey-mi-contractor.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cities/charlevoix-mi-contractor.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cities/gaylord-mi-contractor.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cities/boyne-city-mi-contractor.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cities/cadillac-mi-contractor.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cities/midland-mi-contractor.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cities/bay-city-mi-contractor.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cities/saginaw-mi-contractor.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cities/alpena-mi-contractor.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cities/cheboygan-mi-contractor.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cities/rogers-city-mi-contractor.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cities/west-branch-mi-contractor.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cities/houghton-lake-mi-contractor.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cities/roscommon-mi-contractor.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
